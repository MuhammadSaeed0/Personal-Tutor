{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "riwaq",
    "Audience": "riwaq-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Ai": {
    "Chat": {
      "Provider": "Anthropic",
      "Model": "claude-opus-5-5",
      "ApiKey": "",
      "BaseUrl": "",
      "Effort": "medium",
      "UseServerSideFallback": true,
      "TimeoutSeconds": 180
    },
    "Embeddings": {
      "Provider": "Local",
      "Model": "voyage-3.5",
      "ApiKey": "",
      "BaseUrl": "",
      "Dimensions": 1024,
      "BatchSize": 64
    },
    "Limits": {
      "DailyRequestsPerUser": 300,
      "DailyOutputTokensPerUser": 600000
    }
  },
  "Retrieval": {
    "TopK": 8,
    "MaxPassageChars": 16000
  },
  "Processing": {
    "RunWorker": true,
    "MaxFileSizeMb": 250,
    "MaxPages": 2000,
    "ScannedLetterThreshold": 25,
    "OcrLowConfidence": 60,
    "OcrInvisibleTextLayers": false
  },
  "Ocr": {
    "Enabled": true,
    "TesseractPath": "tesseract",
    "Dpi": 300
  },
  "Storage": {
    "RootPath": "App_Data/storage"
  },
  "Email": {
    "AppBaseUrl": "http://localhost:4200"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "AiPerMinute": 20,
    "UploadsPerHour": 30,
    "GlobalPerMinute": 600
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  }
}
